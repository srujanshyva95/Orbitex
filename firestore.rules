rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function groupRef(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        exists(groupRef(groupId)) &&
        request.auth.uid in get(groupRef(groupId)).data.members;
    }

    function isExistingGroupMember() {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    function isJoiningSelf() {
      return signedIn() &&
        !(request.auth.uid in resource.data.members) &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "members",
          "memberProfiles",
          "leaderboard",
          "updatedAt"
        ]);
    }

    // USER DATA
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // INVITE CODE LOOKUP
    // Minimal signed-in lookup so users can join by ORB-XXXX without reading
    // private group documents before they are members.
    match /groupInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "groupId",
          "groupName",
          "creatorId",
          "createdAt"
        ]) &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.groupId is string &&
        isGroupMember(request.resource.data.groupId);

      allow update: if false;

      allow delete: if signedIn() &&
        resource.data.creatorId == request.auth.uid &&
        isGroupMember(resource.data.groupId);
    }

    // GROUP DATA
    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.creatorId == request.auth.uid;

      allow read, delete: if isExistingGroupMember();
      allow update: if isExistingGroupMember() || isJoiningSelf();

      match /{document=**} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
